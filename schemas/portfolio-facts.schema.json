{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhubao315.github.io/schemas/portfolio-facts.schema.json",
  "title": "ZHUBAO Portfolio Facts Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["_meta", "facts"],
  "properties": {
    "_meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_verified", "maintainer", "note"],
      "properties": {
        "last_verified": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "maintainer": { "const": "human" },
        "note": { "type": "string" }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "source", "as_of"],
        "properties": {
          "value": { "type": ["string", "number"] },
          "source": {
            "enum": ["github_api", "repo_readme", "github_tag", "local_build", "derived", "manual"]
          },
          "as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "derived_from": {
            "type": "array",
            "items": { "type": "string" }
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
