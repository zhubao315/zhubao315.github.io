---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { ArrowUpRight, Search } from '@lucide/astro';
import { projects, researchProjects } from '../../data/projects';
import { site } from '../../data/site';

const workProjects = projects;
const categoryOptions = [
  { key: 'all', label: '全部', en: 'All' },
  { key: 'agent', label: 'AI & Agent', en: 'Agent' },
  { key: 'product', label: '数字产品', en: 'Product' },
  { key: 'knowledge', label: '知识工程', en: 'Knowledge' },
  { key: 'investment', label: '投资研究', en: 'Investment' },
  { key: 'quantified', label: '量化生活', en: 'Measured' },
  { key: 'creative', label: '创意作品', en: 'Creative' },
] as const;

const featuredCount = workProjects.filter((project) => project.featured).length;
---

<BaseLayout
  title="作品与实验 | 朱宝 ZHUBAO"
  description="浏览朱宝的 AI 与 Agent 工程、数字产品、知识工程、投资研究、量化生活与创意作品。原创项目、二次开发与上游研究被明确区分。"
>
  <section class="page-hero">
    <div class="shell">
      <nav class="breadcrumb" aria-label="面包屑">
        <a href="/">首页</a><span class="sep">/</span><span>作品</span>
      </nav>
      <div class="page-hero-title">
        <h1>Systems, products<br /><em>& experiments.</em></h1>
        <span class="page-hero-index">INDEX / 01—{String(workProjects.length).padStart(2, '0')}</span>
      </div>
      <div class="page-hero-grid">
        <p class="page-hero-intro">
          一个项目只有真正运行、被使用、被验证，才值得被称作“作品”。这里汇集可运行的 AI 能力底座、数字产品、知识系统与长期数据实践；Fork 和上游研究不会被包装成原创。
        </p>
        <div class="page-hero-meta">
          <div class="hero-fact"><strong>{workProjects.length}</strong><span>精选与工作室项目</span></div>
          <div class="hero-fact"><strong>{researchProjects.length}</strong><span>上游研究样本</span></div>
          <div class="hero-fact"><strong>{site.lastVerified}</strong><span>最后核验</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section work-index-section">
    <div class="shell">
      <div class="work-filter" data-work-filter>
        <div class="filter-categories" role="group" aria-label="按领域筛选">
          {
            categoryOptions.map((category, index) => (
              <button
                type="button"
                class:list={['filter-button', { 'is-active': index === 0 }]}
                data-filter-category={category.key}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                {category.label}<span>{category.en}</span>
              </button>
            ))
          }
        </div>

        <div class="filter-tools">
          <label class="search-field">
            <Search size={15} stroke-width={1.5} aria-hidden="true" />
            <span class="sr-only">搜索项目</span>
            <input type="search" placeholder="搜索项目、能力或技术栈" data-project-search autocomplete="off" />
          </label>

          <label class="select-field">
            <span>状态</span>
            <select data-project-status>
              <option value="all">全部</option>
              <option value="active">持续建设</option>
              <option value="prototype">原型阶段</option>
              <option value="experiment">实验探索</option>
              <option value="archived">历史归档</option>
            </select>
          </label>

          <button class="filter-reset" type="button" data-filter-reset>重置</button>
        </div>

        <p class="filter-count" aria-live="polite">
          显示 <strong data-filter-count>{workProjects.length}</strong> / {workProjects.length} 个项目
        </p>
      </div>

      <div class="project-grid" data-project-grid>
        {
          workProjects.map((project, index) => (
            <ProjectCard project={project} index={String(index + 1).padStart(2, '0')} />
          ))
        }
      </div>

      <p class="empty-state" data-empty-state hidden>
        没有找到匹配的项目。可以换一个关键词，或重置筛选条件。
      </p>

      <div class="work-index-footer">
        <p>
          首页聚焦 {featuredCount} 个代表项目；其余项目按成熟度展示。每个项目卡片都有本地说明页，技术事实与在线入口以 GitHub / 实时站点为准。
        </p>
        <a class="text-link" href={site.github} target="_blank" rel="noreferrer">
          浏览全部 61 个公开仓库 <ArrowUpRight size={15} stroke-width={1.5} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <section class="section section--paper-alt research-section">
    <div class="shell">
      <header class="research-head" data-reveal>
        <div>
          <p class="eyebrow">Research Archive / Fork & Upstream</p>
          <h2>研究，不等同于原创。</h2>
        </div>
        <p>
          以下仓库来自上游项目的 Fork 或研究性收藏，用于理解架构、工程实现与生态。它们帮助我保持技术判断，但不计入个人原创作品。
        </p>
      </header>

      <div class="research-table" data-reveal>
        <div class="research-table-head">
          <span>NO.</span><span>REPOSITORY</span><span>AREA</span><span>NOTE</span><span>LINK</span>
        </div>
        {
          researchProjects.map((project, index) => (
            <a class="research-row" href={project.githubUrl} target="_blank" rel="noreferrer">
              <span class="research-index">{String(index + 1).padStart(2, '0')}</span>
              <strong>{project.name}<em>FORK / RESEARCH</em></strong>
              <span class="research-area">{project.area}</span>
              <span class="research-note">{project.note}</span>
              <ArrowUpRight size={16} stroke-width={1.4} aria-hidden="true" />
            </a>
          ))
        }
      </div>

      <p class="research-note-bottom">
        Fork 状态依据 GitHub 仓库元数据核验。没找到稳定演示地址的项目不提供虚构 Demo。
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const filterRoot = document.querySelector<HTMLElement>('[data-work-filter]');
  if (filterRoot) {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-project-card]'));
    const categoryButtons = Array.from(filterRoot.querySelectorAll<HTMLButtonElement>('[data-filter-category]'));
    const statusSelect = filterRoot.querySelector<HTMLSelectElement>('[data-project-status]');
    const searchInput = filterRoot.querySelector<HTMLInputElement>('[data-project-search]');
    const resetButton = filterRoot.querySelector<HTMLButtonElement>('[data-filter-reset]');
    const count = filterRoot.querySelector<HTMLElement>('[data-filter-count]');
    const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');
    let activeCategory = 'all';

    const queryCategory = new URLSearchParams(window.location.search).get('filter');
    if (queryCategory && categoryButtons.some((button) => button.dataset.filterCategory === queryCategory)) {
      activeCategory = queryCategory;
    }

    const setCategory = (category: string) => {
      activeCategory = category;
      categoryButtons.forEach((button) => {
        const active = button.dataset.filterCategory === category;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    };

    const applyFilters = () => {
      const query = (searchInput?.value ?? '').trim().toLowerCase();
      const status = statusSelect?.value ?? 'all';
      let visible = 0;

      cards.forEach((card) => {
        const matchesCategory = activeCategory === 'all' || card.dataset.category === activeCategory;
        const matchesStatus = status === 'all' || card.dataset.status === status;
        const matchesQuery = !query || (card.dataset.search ?? '').includes(query);
        const show = matchesCategory && matchesStatus && matchesQuery;
        card.hidden = !show;
        if (show) visible += 1;
      });

      if (count) count.textContent = String(visible);
      if (emptyState) emptyState.hidden = visible !== 0;
    };

    categoryButtons.forEach((button) => {
      button.addEventListener('click', () => {
        setCategory(button.dataset.filterCategory ?? 'all');
        applyFilters();
      });
    });

    statusSelect?.addEventListener('change', applyFilters);
    searchInput?.addEventListener('input', applyFilters);

    resetButton?.addEventListener('click', () => {
      setCategory('all');
      if (statusSelect) statusSelect.value = 'all';
      if (searchInput) searchInput.value = '';
      applyFilters();
      searchInput?.focus();
    });

    setCategory(activeCategory);
    applyFilters();
  }
</script>
