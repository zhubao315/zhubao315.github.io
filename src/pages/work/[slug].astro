---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import { ArrowUpRight, ArrowLeft, ArrowRight } from '@lucide/astro';
import {
  projects,
  featuredProjects,
  categoryMeta,
  statusMeta,
  sourceMeta,
  type Project,
} from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: projects[(index - 1 + projects.length) % projects.length],
      next: projects[(index + 1) % projects.length],
    },
  }));
}

interface Props {
  project: Project;
  prev: Project;
  next: Project;
}

const { project, prev, next } = Astro.props;
const category = categoryMeta[project.category];
const status = statusMeta[project.status];
const source = sourceMeta[project.sourceType];
const hasVisual =
  Boolean(project.cover) ||
  ['uskill', 'knowledge-base-engineering', 'investment-discipline', 'quantified-life'].includes(project.id);
const related = featuredProjects.filter((item) => item.id !== project.id).slice(0, 3);
const pageTitle = `${project.name} · ${project.nameZh} | 朱宝 ZHUBAO`;
const metaDescription = `${project.summary} ${project.tagline}`;

const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.name,
  alternateName: project.nameZh,
  description: project.summary,
  url: new URL(`/work/${project.slug}/`, 'https://zhubao315.github.io').href,
  author: { '@type': 'Person', name: '朱宝', url: 'https://zhubao315.github.io' },
  keywords: project.tech.join(', '),
  codeRepository: project.githubUrl,
  ...(project.demoUrl ? { sameAs: [project.demoUrl, project.githubUrl] } : { sameAs: [project.githubUrl] }),
};
---

<BaseLayout
  title={pageTitle}
  description={metaDescription}
  image={project.cover?.src ?? '/og-default.png'}
  type="article"
>
  <article class="project-page">
    <header class="project-hero">
      <div class="shell">
        <nav class="breadcrumb" aria-label="面包屑">
          <a href="/">首页</a><span class="sep">/</span>
          <a href="/work/">作品</a><span class="sep">/</span>
          <span>{project.name}</span>
        </nav>

        <div class="project-hero-top">
          <div>
            <p class="eyebrow">{category.label} / {category.labelZh} · SOURCE: {source.label}</p>
            <h1>{project.name}</h1>
            <p class="project-hero-zh">{project.nameZh}</p>
            <p class="project-hero-tagline">{project.tagline}</p>
          </div>
          <dl class="project-hero-facts">
            <div><dt>STATUS</dt><dd><span class:list={['status-label', `status-label--${project.status}`]}><i aria-hidden="true"></i>{status.labelZh}</span></dd></div>
            <div><dt>SOURCE</dt><dd>{source.labelZh}</dd></div>
            <div><dt>LAST VERIFIED</dt><dd>{project.lastVerified}</dd></div>
          </dl>
        </div>

        <div class="project-hero-bottom">
          <p class="project-hero-description">{project.description ?? project.summary}</p>
          <div class="project-hero-links">
            {
              project.demoUrl && (
                <a class="button" href={project.demoUrl} target="_blank" rel="noreferrer">
                  {project.demoLabel ?? '在线体验'} <ArrowUpRight size={16} stroke-width={1.5} aria-hidden="true" />
                </a>
              )
            }
            <a class="button button--ghost" href={project.githubUrl} target="_blank" rel="noreferrer">
              GitHub <ArrowUpRight size={16} stroke-width={1.5} aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </header>

    {
      hasVisual ? (
        <div class="project-hero-visual">
          <div class="shell">
            <ProjectMedia project={project} mode="hero" />
          </div>
        </div>
      ) : (
        <div class="project-hero-placeholder">
          <div class="shell">
            <div class="placeholder-panel">
              <span class="placeholder-index">CASE / {project.lastVerified.slice(0, 4)}</span>
              <span class="placeholder-category">{category.label} · {category.labelZh}</span>
              <strong>{project.name}</strong>
              <p>{project.summary}</p>
              <span class="placeholder-mark" aria-hidden="true">✦</span>
            </div>
          </div>
        </div>
      )
    }

    <div class="section project-content-section">
      <div class="shell">
        <div class="project-content-grid">
          <div class="project-main">
            {
              project.caseStudy ? (
                <>
                  <section class="case-section" data-reveal>
                    <p class="case-kicker">01 / CONTEXT</p>
                    <h2>问题与判断</h2>
                    {project.caseStudy.context.map((paragraph) => <p>{paragraph}</p>)}
                  </section>

                  <section class="case-section" data-reveal>
                    <p class="case-kicker">02 / APPROACH</p>
                    <h2>如何把它做成系统</h2>
                    <div class="approach-list">
                      {project.caseStudy.approach.map((step) => (
                        <div class="approach-step">
                          <span>{step.index}</span>
                          <div>
                            <h3>{step.title}</h3>
                            <p>{step.body}</p>
                          </div>
                        </div>
                      ))}
                    </div>
                  </section>

                  <section class="case-section" data-reveal>
                    <p class="case-kicker">03 / EVIDENCE</p>
                    <h2>公开可核验的成果</h2>
                    <ul class="evidence-list">
                      {project.caseStudy.evidence.map((item) => <li>{item}</li>)}
                    </ul>
                  </section>

                  {project.caseStudy.boundaries && (
                    <section class="case-section case-section--boundaries" data-reveal>
                      <p class="case-kicker">04 / BOUNDARIES</p>
                      <h2>边界与未完成</h2>
                      <ul class="boundary-list">
                        {project.caseStudy.boundaries.map((item) => <li>{item}</li>)}
                      </ul>
                    </section>
                  )}
                </>
              ) : (
                <>
                  <section class="case-section" data-reveal>
                    <p class="case-kicker">01 / OVERVIEW</p>
                    <h2>项目说明</h2>
                    <p>{project.description ?? project.summary}</p>
                  </section>
                  <section class="case-section" data-reveal>
                    <p class="case-kicker">02 / STATUS</p>
                    <h2>当前状态</h2>
                    <p>
                      这是一个仍在整理中的项目方向。当前阶段为「{status.labelZh}」，类型为「{source.labelZh}」。
                      页面不虚构未公开的功能、用户数据或在线演示；项目事实与最新进展以 GitHub 仓库为准。
                    </p>
                  </section>
                  <section class="case-section case-section--boundaries" data-reveal>
                    <p class="case-kicker">03 / NOTES</p>
                    <h2>说明</h2>
                    <ul class="boundary-list">
                      <li>项目截图、功能与使用方式以仓库 README 与源码为准。</li>
                      <li>没有稳定演示地址的项目，不提供伪造的 Demo 链接。</li>
                      <li>此页最后核验于 {project.lastVerified}。</li>
                    </ul>
                  </section>
                </>
              )
            }

            {project.sourceNote && (
              <aside class="source-note">
                <span>SOURCE NOTE</span>
                <p>{project.sourceNote}</p>
              </aside>
            )}

            {
              project.extraLinks && (
                <section class="case-section" data-reveal>
                  <p class="case-kicker">EXTRA / LIVE SITES</p>
                  <h2>打开各个独立站点</h2>
                  <div class="extra-links">
                    {project.extraLinks.map((link) => (
                      <a href={link.href} target="_blank" rel="noreferrer">
                        {link.label} <ArrowUpRight size={16} stroke-width={1.5} aria-hidden="true" />
                      </a>
                    ))}
                  </div>
                </section>
              )
            }
          </div>

          <aside class="project-sidebar" data-reveal>
            <div class="sidebar-block">
              <p class="sidebar-label">PROJECT FACTS</p>
              <dl class="fact-list">
                <div><dt>状态</dt><dd>{status.labelZh}</dd></div>
                <div><dt>来源</dt><dd>{source.labelZh}</dd></div>
                <div><dt>领域</dt><dd>{category.labelZh}</dd></div>
                <div><dt>核验</dt><dd>{project.lastVerified}</dd></div>
              </dl>
            </div>

            <div class="sidebar-block">
              <p class="sidebar-label">STACK</p>
              <ul class="sidebar-tech">
                {project.tech.map((tech) => <li>{tech}</li>)}
              </ul>
            </div>

            <div class="sidebar-block">
              <p class="sidebar-label">LINKS</p>
              <div class="sidebar-links">
                <a href={project.githubUrl} target="_blank" rel="noreferrer">
                  <span>GitHub repository</span><span>↗</span>
                </a>
                {project.demoUrl && (
                  <a href={project.demoUrl} target="_blank" rel="noreferrer">
                    <span>{project.demoLabel ?? 'Live site'}</span><span>↗</span>
                  </a>
                )}
                {project.extraLinks?.map((link) => (
                  <a href={link.href} target="_blank" rel="noreferrer">
                    <span>{link.label}</span><span>↗</span>
                  </a>
                ))}
              </div>
            </div>

            <p class="sidebar-note">
              项目事实核验于 {project.lastVerified}。功能、测试数与在线状态可能随仓库更新而变化。
            </p>
          </aside>
        </div>
      </div>
    </div>

    {
      related.length > 0 && (
        <section class="section related-section">
          <div class="shell">
            <div class="related-head">
              <div>
                <p class="eyebrow">Keep exploring / Related work</p>
                <h2>继续浏览其他作品</h2>
              </div>
              <a class="text-link" href="/work/">全部项目 <ArrowUpRight size={15} stroke-width={1.4} aria-hidden="true" /></a>
            </div>
            <div class="related-grid">
              {related.map((item) => (
                <a class="related-card" href={`/work/${item.slug}/`}>
                  <span>{categoryMeta[item.category].label}</span>
                  <strong>{item.name}</strong>
                  <p>{item.tagline}</p>
                  <ArrowUpRight size={18} stroke-width={1.4} aria-hidden="true" />
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <nav class="project-pager" aria-label="项目翻页">
      <div class="shell project-pager-inner">
        <a href={`/work/${prev.slug}/`}>
          <span><ArrowLeft size={15} stroke-width={1.4} aria-hidden="true" /> Previous</span>
          <strong>{prev.name}</strong>
        </a>
        <a class="project-pager-next" href={`/work/${next.slug}/`}>
          <span>Next <ArrowRight size={15} stroke-width={1.4} aria-hidden="true" /></span>
          <strong>{next.name}</strong>
        </a>
      </div>
    </nav>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(projectSchema)} />
</BaseLayout>
