---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ArrowUpRight, ArrowLeft } from '@lucide/astro';
import { books, readerUrl, noteUrl } from '../../data/books';
import { projects } from '../../data/projects';
import '../../styles/books.css';

export function getStaticPaths() {
  return books.map((book, index) => ({
    params: { slug: book.slug },
    props: {
      book,
      prev: books[(index - 1 + books.length) % books.length],
      next: books[(index + 1) % books.length],
    },
  }));
}

interface Props {
  book: (typeof books)[number];
  prev: (typeof books)[number];
  next: (typeof books)[number];
}

const { book, prev, next } = Astro.props;
const relatedProjects = book.relatedProjects
  .map((slug) => projects.find((project) => project.slug === slug))
  .filter((project) => Boolean(project));
const relatedArticles = book.relatedArticles.map((id) => ({
  id,
  label: id
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' '),
}));
const articleTitles: Record<string, string> = {
  'why-knowledge-bases-get-harder': '为什么个人知识库越积累越难用？',
  'obsidian-governance-workflow': '把知识库治理写成可复跑流程',
  'skill-evaluation-gates': 'Skill 的评测门禁',
  'all-disciplines-lead-to-psychology': '所有领域最终通向心理学',
  'three-lines-of-life-os': '健康、投资、心理：人生操作系统的三条主线',
  'compounding-across-domains': '复利不是公式，是四个领域共用的失败清单',
};
const title = `${book.title} · 自著书稿 | 朱宝 ZHUBAO`;
---

<BaseLayout title={title} description={`${book.subtitle}。${book.summary}`}>
  <section class="books-hero">
    <div class="shell">
      <nav class="breadcrumb" aria-label="面包屑">
        <a href="/">首页</a><span class="sep">/</span>
        <a href="/books/">书稿</a><span class="sep">/</span>
        <span>{book.title}</span>
      </nav>
      <p class="repos-kicker">{book.directionIndex} / {book.direction} · {book.directionLabel}</p>
      <h1>{book.title}</h1>
      <p class="books-lede">{book.subtitle}</p>
      <div class="books-meta">
        <div><strong>{book.status}</strong><span>书稿状态</span></div>
        <div><strong>{book.lastVerified}</strong><span>事实核验</span></div>
        <div><strong>{book.facts.length}</strong><span>公开口径</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell book-detail-hero">
      <div>
        <h2 class="sr-only">核心观点</h2>
        <p style="line-height:1.85;color:var(--muted);max-width:70ch">{book.summary}</p>

        <div class="book-actions">
          <a class="text-link" href={readerUrl(book.readerId)} target="_blank" rel="noreferrer">
            在线阅读全书 <ArrowUpRight size={14} aria-hidden="true" />
          </a>
          <a class="text-link" href={noteUrl(book.noteSlug)} target="_blank" rel="noreferrer">
            公开读书笔记 <ArrowUpRight size={14} aria-hidden="true" />
          </a>
          {book.companion && (
            <a class="text-link" href={book.companion.href} target="_blank" rel="noreferrer">
              {book.companion.label} <ArrowUpRight size={14} aria-hidden="true" />
            </a>
          )}
        </div>

        <div class="section-head" style="margin-top:42px">
          <div class="section-index"><span>01</span><i aria-hidden="true"></i></div>
          <div class="section-title">
            <p class="eyebrow">Core Thesis / 核心观点</p>
            <h2>来自公开读书笔记的<br />原文提炼。</h2>
          </div>
        </div>
        <ol class="book-thesis">
          {book.thesis.map((point) => <li>{point}</li>)}
        </ol>

        <div class="section-head" style="margin-top:48px">
          <div class="section-index"><span>02</span><i aria-hidden="true"></i></div>
          <div class="section-title">
            <p class="eyebrow">Cross References / 互引</p>
            <h2>观点、笔记、项目，<br />互相指向。</h2>
          </div>
        </div>
        <div class="book-related">
          <div>
            <h3>公开笔记 · uRead</h3>
            <ul>
              <li>
                <a href={noteUrl(book.noteSlug)} target="_blank" rel="noreferrer">
                  {book.noteTitle} <ArrowUpRight size={12} aria-hidden="true" />
                </a>
              </li>
            </ul>
          </div>
          <div>
            <h3>相关项目 · 本站</h3>
            <ul>
              {relatedProjects.map((project) => (
                <li><a href={`/work/${project!.slug}/`}>{project!.name}</a></li>
              ))}
            </ul>
          </div>
          <div>
            <h3>相关观点 · 本站文章</h3>
            <ul>
              {relatedArticles.map((article) => (
                <li><a href={`/articles/${article.id}/`}>{articleTitles[article.id] ?? article.label}</a></li>
              ))}
            </ul>
          </div>
        </div>

        <div class="book-boundaries" style="margin-top:36px">
          <strong>边界与口径</strong>
          <ul>
            {book.boundaries.map((boundary) => <li>{boundary}</li>)}
            <li>读书笔记由 uRead 公开托管；各站点实时页面为最终事实源。</li>
          </ul>
        </div>

        <nav class="article-pager" aria-label="书稿导航" style="margin-top:36px">
          <a href={`/books/${prev.slug}/`}><ArrowLeft size={13} aria-hidden="true" /> {prev.title}</a>
          <a href={`/books/${next.slug}/`}>{next.title} <ArrowUpRight size={13} aria-hidden="true" /></a>
        </nav>
      </div>

      <aside>
        <div class={`book-detail-cover ${book.coverClass}`} aria-hidden="true">
          <span>ZHUBAO / {book.directionIndex}</span>
          <b>{book.title}</b>
          <small>MANUSCRIPT · 2026</small>
        </div>
        <ul class="book-thesis" style="margin-top:24px">
          {book.facts.map((fact) => <li>{fact}</li>)}
        </ul>
        <p style="margin-top:18px;font-size:0.8rem;color:var(--muted);line-height:1.7">
          阅读器：<a href={readerUrl(book.readerId)} target="_blank" rel="noreferrer">uRead #{book.readerId}</a>
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>
