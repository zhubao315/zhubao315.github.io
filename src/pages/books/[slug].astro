---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { ArrowUpRight, ArrowLeft } from '@lucide/astro';
import { books, readerUrl, noteUrl } from '../../data/books';
import { projects } from '../../data/projects';
import '../../styles/books.css';

export function getStaticPaths() {
  return books.map((book, index) => ({
    params: { slug: book.slug },
    props: {
      book,
      prev: books[(index - 1 + books.length) % books.length],
      next: books[(index + 1) % books.length],
    },
  }));
}

interface Props {
  book: (typeof books)[number];
  prev: (typeof books)[number];
  next: (typeof books)[number];
}

const { book, prev, next } = Astro.props;
const relatedProjects = book.relatedProjects
  .map((slug) => projects.find((project) => project.slug === slug))
  .filter((project) => Boolean(project));
// 文章标题从内容集合读取，不在页面里维护第二份标题表；
// 指向不存在文章的条目直接跳过，避免生成死链。
const articlesById = new Map((await getCollection('articles')).map((article) => [article.id, article]));
const relatedArticles = book.relatedArticles
  .map((id) => ({ id, article: articlesById.get(id) }))
  .filter((entry): entry is { id: string; article: NonNullable<typeof entry.article> } => Boolean(entry.article))
  .map(({ id, article }) => ({ id, title: article.data.title }));
const title = `${book.title} · 自著书稿 | 朱宝 ZHUBAO`;
---

<BaseLayout title={title} description={`${book.subtitle}。${book.summary}`}>
  <section class="books-hero">
    <div class="shell">
      <nav class="breadcrumb" aria-label="面包屑">
        <a href="/">首页</a><span class="sep">/</span>
        <a href="/books/">书稿</a><span class="sep">/</span>
        <span>{book.title}</span>
      </nav>
      <p class="repos-kicker">{book.directionIndex} / {book.direction} · {book.directionLabel}</p>
      <h1>{book.title}</h1>
      <p class="books-lede">{book.subtitle}</p>
      <div class="books-meta">
        <div><strong>{book.status}</strong><span>书稿状态</span></div>
        <div><strong>{book.lastVerified}</strong><span>事实核验</span></div>
        <div><strong>{book.facts.length}</strong><span>公开口径</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell book-detail-hero">
      <div>
        <h2 class="sr-only">核心观点</h2>
        <p style="line-height:1.85;color:var(--muted);max-width:70ch">{book.summary}</p>

        <div class="book-actions">
          <a class="text-link" href={readerUrl(book.readerId)} target="_blank" rel="noreferrer" data-book-outbound="reader" data-link-location="hero">
            在线阅读全书 <ArrowUpRight size={14} aria-hidden="true" />
          </a>
          <a class="text-link" href={noteUrl(book.noteAlias)} target="_blank" rel="noreferrer" data-book-outbound="notes" data-link-location="hero">
            公开读书笔记 <ArrowUpRight size={14} aria-hidden="true" />
          </a>
          {book.companion && (
            <a class="text-link" href={book.companion.href} target="_blank" rel="noreferrer">
              {book.companion.label} <ArrowUpRight size={14} aria-hidden="true" />
            </a>
          )}
        </div>

        <nav class="book-jump" aria-label="本页章节导航">
          <a href="#core-thesis">核心观点 <span>{book.corePoints.length}</span></a>
          <a href="#quotes">金句解析 <span>{book.quotes.length}</span></a>
          <a href="#references">互引</a>
        </nav>

        <div class="section-head" id="core-thesis" style="margin-top:42px">
          <div class="section-index"><span>01</span><i aria-hidden="true"></i></div>
          <div class="section-title">
            <p class="eyebrow">Core Thesis / 核心观点</p>
            <h2>来自公开读书笔记的<br />原文提炼。</h2>
          </div>
        </div>
        <ol class="book-thesis">
          {book.corePoints.map((point) => (
            <li><span>{point.split('**').map((part, i) => (i % 2 === 1 ? <strong>{part}</strong> : part))}</span></li>
          ))}
        </ol>

        <div class="section-head" id="quotes" style="margin-top:48px">
          <div class="section-index"><span>02</span><i aria-hidden="true"></i></div>
          <div class="section-title">
            <p class="eyebrow">Quotes &amp; Deep Analysis / 金句摘录与深度解析</p>
            <h2>原文、语境，<br />以及它真正的含义。</h2>
          </div>
        </div>
        <p class="book-quotes-note">以下金句与解析逐条摘自公开笔记《{book.noteTitle}》，按「原文 — 语境 — 深度解析」三段呈现；它们是笔记的转录，不代表对原典的独立核验。</p>
        <ol class="book-quotes">
          {book.quotes.map((quote, i) => (
            <li class="book-quote">
              <span class="book-quote-index">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <blockquote class="book-quote-text">「{quote.text}」</blockquote>
                <dl class="book-quote-meta">
                  <dt>语境</dt><dd>{quote.context}</dd>
                  <dt>深度解析</dt><dd>{quote.analysis}</dd>
                </dl>
              </div>
            </li>
          ))}
        </ol>

        <div class="section-head" id="references" style="margin-top:48px">
          <div class="section-index"><span>03</span><i aria-hidden="true"></i></div>
          <div class="section-title">
            <p class="eyebrow">Cross References / 互引</p>
            <h2>观点、笔记、项目，<br />互相指向。</h2>
          </div>
        </div>
        <div class="book-related">
          <div>
            <h3>公开笔记 · uRead</h3>
            <ul>
              <li>
                <a href={noteUrl(book.noteAlias)} target="_blank" rel="noreferrer" data-book-outbound="notes" data-link-location="references">
                  {book.noteTitle} <ArrowUpRight size={12} aria-hidden="true" />
                </a>
              </li>
            </ul>
          </div>
          <div>
            <h3>相关项目 · 本站</h3>
            <ul>
              {relatedProjects.map((project) => (
                <li><a href={`/work/${project!.slug}/`}>{project!.name}</a></li>
              ))}
            </ul>
          </div>
          <div>
            <h3>相关观点 · 本站文章</h3>
            <ul>
              {relatedArticles.map((article) => (
                <li><a href={`/articles/${article.id}/`}>{article.title}</a></li>
              ))}
            </ul>
          </div>
        </div>

        <div class="book-boundaries" style="margin-top:36px">
          <strong>边界与口径</strong>
          <ul>
            {book.boundaries.map((boundary) => <li>{boundary}</li>)}
            <li>读书笔记由 uRead 公开托管；各站点实时页面为最终事实源。</li>
          </ul>
        </div>

        <nav class="article-pager" aria-label="书稿导航" style="margin-top:36px">
          <a href={`/books/${prev.slug}/`}><ArrowLeft size={13} aria-hidden="true" /> {prev.title}</a>
          <a href={`/books/${next.slug}/`}>{next.title} <ArrowUpRight size={13} aria-hidden="true" /></a>
        </nav>
      </div>

      <aside>
        <div class={`book-detail-cover ${book.coverClass}`}>
          <Image src={book.cover} alt={book.coverAlt} widths={[260, 520]} sizes="260px" />
        </div>
        <ul class="book-thesis" style="margin-top:24px">
          {book.facts.map((fact) => <li>{fact}</li>)}
        </ul>
        <p style="margin-top:18px;font-size:0.8rem;color:var(--muted);line-height:1.7">
          阅读器：<a href={readerUrl(book.readerId)} target="_blank" rel="noreferrer" data-book-outbound="reader" data-link-location="sidebar">uRead #{book.readerId}</a>
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ bookSlug: book.slug, bookDirection: book.direction }}>
  document.querySelectorAll('[data-book-outbound]').forEach((link) => {
    link.addEventListener('click', () => {
      const outboundType = link.dataset.bookOutbound;
      const outboundDetails = {
        book_slug: bookSlug,
        book_direction: bookDirection,
        link_location: link.dataset.linkLocation,
        outbound_type: outboundType,
      };
      window.posthog?.capture(
        outboundType === 'reader' ? 'book_reader_opened' : 'book_notes_opened',
        outboundDetails,
      );
      window.posthog?.logger?.info('book outbound link opened', outboundDetails);
    });
  });
</script>
