---
import BaseLayout from '../layouts/BaseLayout.astro';
import DirectionMark from '../components/DirectionMark.astro';
import { ArrowUpRight, ArrowRight } from '@lucide/astro';
import { directions, principles, site } from '../data/site';
import { lifeSites } from '../data/projects';

const totalActivities = 2037 + 5776 + 344;
const totalDistance = 24548 + 45291 + 2694;

const capabilities = [
  {
    index: '01',
    title: 'AI & Agent Systems',
    zh: '智能系统工程',
    body: 'Agent Skills、执行器、Schema、CLI 与知识上下文。关心能力如何被版本化、授权、验证，而不只是被调用。',
    tools: ['Python', 'YAML / JSON Schema', 'OpenAI-compatible APIs', 'Agent Skills'],
  },
  {
    index: '02',
    title: 'Product Engineering',
    zh: '产品工程',
    body: '从信息架构、交互到静态发布。把复杂方法压缩成一个让人愿意开始、也能继续探索的产品入口。',
    tools: ['TypeScript', 'Next.js', 'Astro', 'Static architecture'],
  },
  {
    index: '03',
    title: 'Knowledge & Research',
    zh: '知识与研究',
    body: '知识库治理、证据链、投资纪律与长期写作。让观点带来源，让结论知道自己的边界。',
    tools: ['Knowledge governance', 'Evidence mapping', 'Investment rules', 'Long-form writing'],
  },
  {
    index: '04',
    title: 'Data & Quantified Life',
    zh: '数据与量化生活',
    body: '把设备数据变成可复跑、可解释的长期档案。缺失值保持缺失，同步失败不推进水位。',
    tools: ['SQLite', 'FIT / GPX', 'Data pipelines', 'Static visualization'],
  },
  {
    index: '05',
    title: 'Creative Direction',
    zh: '创意与叙事',
    body: '原创动画、视觉系统与叙事网站。让技术不只停留在可用，也能被感受和记住。',
    tools: ['2D animation', 'AI image / audio', 'Editorial design', 'Storytelling'],
  },
];

const timeline = [
  {
    year: '2011',
    code: 'ORIGIN',
    title: '公开的开始',
    body: '加入 GitHub。此后十五年的公开提交、仓库与研究痕迹，构成了这份档案的原始材料。',
  },
  {
    year: '2015',
    code: 'RECORD',
    title: '第一批可查询的运动记录',
    body: '跑步数据的最早记录可追溯到 2015 年。记录不是为了展示峰值，而是给长期变化留下可比的口径。',
  },
  {
    year: '2022',
    code: 'LEGACY',
    title: '上一版博客',
    body: '2022 年 7 月，旧版 Hexo 博客留下两个公开入口。原生成页面已无正文，本次重建选择保留 URL，而不是虚构历史文章。',
  },
  {
    year: '2023',
    code: 'MEASURE',
    title: '健康数据成为长期系统',
    body: '健康记录从 2023 年底持续同步至今，覆盖睡眠、HRV、静息心率与训练负荷等 11 项指标。',
  },
  {
    year: '2024—2026',
    code: 'BUILD',
    title: '从方法到可运行的作品',
    body: 'MBTI64、uSkill、知识库工程、投资的纪律、量化生活与《满分的我》逐渐形成一个互相验证的作品集：产品、能力底座、治理方法和叙事作品。',
  },
  {
    year: '2026.11',
    code: 'NOW',
    title: '重新建立公开界面',
    body: '用 Astro 重建个人数字作品集，统一项目事实、区分原创与上游研究，并为旧 URL 保留可解释的兼容入口。',
  },
];
---

<BaseLayout
  title="关于朱宝 | AI 系统、产品工程与知识工程"
  description="朱宝的个人工作档案：AI 与 Agent 系统、数字产品、知识工程、投资研究与量化生活。这里记录方法、证据、边界与持续建设中的作品。"
  type="profile"
>
  <section class="page-hero about-hero page-hero--brand">
    <div class="shell">
      <nav class="breadcrumb" aria-label="面包屑">
        <a href="/">首页</a><span class="sep">/</span><span>关于</span>
      </nav>

      <div class="page-masthead">
        <span><i aria-hidden="true"></i> PROFILE / PERSONAL ARCHIVE</span>
        <span>IDENTITY · PHILOSOPHY · PRINCIPLES · BOUNDARIES</span>
        <span>SNAPSHOT {site.lastVerified}</span>
      </div>

      <div class="page-hero-title">
        <h1>Still building.<br /><em>Still becoming.</em></h1>
        <span class="page-hero-index">PROFILE / 04</span>
      </div>
      <div class="page-hero-grid">
        <p class="page-hero-intro">
          我是朱宝。这份网站不是一张职位名片，而是一份持续更新的工作档案：
          我把 AI 能力、知识方法、投资纪律与长期身体数据做成可以运行、被验证、可回溯的系统。
        </p>
        <div class="page-hero-meta">
          <div class="hero-fact"><strong>{site.repoCount}</strong><span>公开仓库</span></div>
          <div class="hero-fact"><strong>{site.nonForkCount}</strong><span>非 Fork 仓库</span></div>
          <div class="hero-fact"><strong>2011</strong><span>加入 GitHub</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section about-intro">
    <div class="shell">
      <div class="about-intro-grid">
        <aside class="about-portrait-card" data-reveal>
          <div class="about-portrait-top">
            <span>PERSONAL FILE / 001</span>
            <span>CN · UTC+8</span>
          </div>
          <div class="about-portrait-media">
            <img src="/images/avatar.webp" alt="朱宝的公开 GitHub 头像" width="480" height="480" />
            <span class="about-portrait-stamp">PUBLIC<br />AVATAR</span>
          </div>
          <div class="about-portrait-id">
            <div>
              <strong>朱宝</strong>
              <span>ZHUBAO / PERSONAL ARCHIVE</span>
            </div>
            <span class="about-portrait-code">BJ—01</span>
          </div>
          <dl class="about-portrait-facts">
            <div><dt>BASE</dt><dd>北京 · UTC+8</dd></div>
            <div><dt>FOCUS</dt><dd>AI systems · knowledge · products</dd></div>
            <div><dt>VERIFIED</dt><dd>{site.lastVerified}</dd></div>
          </dl>
          <p class="about-portrait-note">
            头像来自公开 GitHub 资料；使用前经过裁切与低饱和度处理。它只是一个小尺寸身份标记，不是正式肖像。
          </p>
        </aside>

        <div class="about-manifesto" data-reveal style="--reveal-delay:100ms">
          <p class="eyebrow">A working statement / 自述</p>
          <h2>
            我不急着证明自己什么都懂，<br />
            <em>更在意哪些东西在三年后仍然成立。</em>
          </h2>
          <div class="about-copy">
            <p>
              我的工作围绕四个问题展开：如何让 AI 的能力有结构、有边界、可治理；如何把知识从收藏变成可调用的资产；
              如何在不可预测的市场里保持决策纪律；如何用长期数据理解身体与时间。
            </p>
            <p>
              这些问题看起来分散，底层方法却相同：先定义问题，再建立证据；先做最小可运行系统，再谈规模；
              把失败、缺失和未完成写在明面上，而不是用漂亮的叙事盖过去。
            </p>
            <p>
              这个作品集里的项目有不同成熟度。有的是持续运行的产品，有的是仍在迭代的原型，有的是对上游技术的研究。
              我不会把 Fork 包装成原创，也不会为没有验证的数字编一个好看的来源。
            </p>
          </div>
          <div class="about-signature">
            <span>ZHUBAO</span>
            <span>Builder · Researcher · Recorder</span>
          </div>
          <div class="about-actions">
            <a class="button" href="/work/">
              查看作品 <ArrowRight size={16} stroke-width={1.5} aria-hidden="true" />
            </a>
            <a class="text-link" href={site.github} target="_blank" rel="noreferrer">
              GitHub <ArrowUpRight size={15} stroke-width={1.5} aria-hidden="true" />
            </a>
            <a class="text-link" href={site.x} target="_blank" rel="noreferrer">
              X / Twitter <ArrowUpRight size={15} stroke-width={1.5} aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section about-system">
    <div class="shell">
      <div class="about-system-panel" data-reveal>
        <div class="about-system-lead">
          <p class="eyebrow">Brand Philosophy / Z-Grid</p>
          <h2>四个方向，<br /><em>一个持续生长的系统。</em></h2>
          <p class="about-system-copy">
            BUILD、THINK、MEASURE、CREATE 不是四个并列的标签，而是同一套方法的四个出口：把想法做成系统，把知识变成资产，把生活记录成数据，把经验做成作品。它们共享同一条路径，也共享同一条底线——可验证。
          </p>
          <div class="about-system-mark">
            <img src="/brand/zhubao-symbol.png" alt="ZHUBAO Z-Grid 标志" width="592" height="530" />
            <span>Z-GRID / FOUR DIRECTIONS<br />EST. 2011 — STILL BUILDING</span>
          </div>
        </div>

        <div class="about-system-grid">
          {
            directions.map((direction) => (
              <a class="about-system-item" href={direction.href} data-accent={direction.accent}>
                <span class="about-system-top">
                  <span>{direction.index}</span>
                  <DirectionMark type={direction.code as 'BUILD' | 'THINK' | 'MEASURE' | 'CREATE'} />
                </span>
                <strong>{direction.code}</strong>
                <span class="about-system-zh">{direction.title}</span>
                <p>{direction.description}</p>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark about-principles">
    <div class="shell">
      <header class="section-head section-head--dark" data-reveal>
        <div class="section-index"><span>01</span><i aria-hidden="true"></i></div>
        <div class="section-title">
          <p class="eyebrow">Operating System / 工作原则</p>
          <h2>方法不是口号，<br />是遇到取舍时站哪一边。</h2>
        </div>
        <div class="section-aside">
          <p class="section-note">
            这四条原则并不宏大，但会约束每一个项目：什么该自动化，什么必须留给人类，什么应该在页面上明确说“不知道”。
          </p>
        </div>
      </header>

      <div class="about-principles-grid">
        {
          principles.map((principle) => (
            <article class="about-principle" data-reveal>
              <span class="about-principle-index">{principle.index}</span>
              <h3>{principle.title}</h3>
              <p>{principle.body}</p>
              <span class="about-principle-mark" aria-hidden="true">✦</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section about-record">
    <div class="shell">
      <div class="about-record-head">
        <div>
          <p class="eyebrow">Public Record / 公开记录</p>
          <h2>可以被核对的数字，<br /><em>比形容词更可靠。</em></h2>
        </div>
        <p>
          以下数字来自 GitHub 元数据与各项目公开页面，核验于 {site.lastVerified}。
          它们是时间点快照，会继续变化；不是用户规模、收入或增长指标。
        </p>
      </div>

      <div class="about-record-grid">
        <div class="about-record-stat about-record-stat--wide" data-reveal>
          <span class="about-record-label">GITHUB / PUBLIC ARCHIVE</span>
          <strong>{site.repoCount}</strong>
          <p>个公开仓库，其中 {site.nonForkCount} 个非 Fork，{site.forkCount} 个 Fork / 上游研究。</p>
          <span class="about-record-foot">SOURCE: GitHub API · {site.lastVerified}</span>
        </div>
        <div class="about-record-stat" data-reveal style="--reveal-delay:60ms">
          <span class="about-record-label">LONGITUDINAL HEALTH</span>
          <strong>{lifeSites[0].stat}</strong>
          <p>天连续健康数据，覆盖睡眠、HRV、静息心率与训练负荷等指标。</p>
          <span class="about-record-foot">SNAPSHOT: health dashboard</span>
        </div>
        <div class="about-record-stat" data-reveal style="--reveal-delay:120ms">
          <span class="about-record-label">MOVEMENT / COMBINED</span>
          <strong>{totalActivities.toLocaleString('en-US')}</strong>
          <p>次跑步、骑行与徒步记录，合计约 {totalDistance.toLocaleString('en-US')} km。</p>
          <span class="about-record-foot">DERIVED FROM PUBLIC PAGES</span>
        </div>
        <div class="about-record-stat" data-reveal style="--reveal-delay:180ms">
          <span class="about-record-label">MANUSCRIPTS</span>
          <strong>02</strong>
          <p>部仍在生长的书稿。没有可核实的 ISBN 与发行信息，因此不称为已出版。</p>
          <span class="about-record-foot">STATUS: manuscript / in progress</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--paper-alt about-trajectory">
    <div class="shell">
      <header class="section-head" data-reveal>
        <div class="section-index"><span>02</span><i aria-hidden="true"></i></div>
        <div class="section-title">
          <p class="eyebrow">Trajectory / 时间线</p>
          <h2>不是一条职业阶梯，<br />是一条持续收敛的路线。</h2>
        </div>
        <div class="section-aside">
          <p class="section-note">
            只列出有公开依据的时间锚点。没有确切日期的经历，不在这里补写。
          </p>
        </div>
      </header>

      <ol class="about-timeline">
        {
          timeline.map((item) => (
            <li class="about-timeline-row" data-reveal>
              <time>{item.year}</time>
              <span class="about-timeline-code">{item.code}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
              <span class="about-timeline-dot" aria-hidden="true"></span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section about-capabilities">
    <div class="shell">
      <header class="section-head" data-reveal>
        <div class="section-index"><span>03</span><i aria-hidden="true"></i></div>
        <div class="section-title">
          <p class="eyebrow">Practice / 工作范围</p>
          <h2>五条能力线，<br />共享一套证据标准。</h2>
        </div>
        <div class="section-aside">
          <p class="section-note">
            工具列表来自当前项目实际使用的技术，不代表熟练度评分或认证。能力最终由作品与可复跑结果说明。
          </p>
        </div>
      </header>

      <div class="about-capability-list">
        {
          capabilities.map((capability) => (
            <article class="about-capability" data-reveal>
              <span class="about-capability-index">{capability.index}</span>
              <div class="about-capability-title">
                <h3>{capability.title}</h3>
                <span>{capability.zh}</span>
              </div>
              <p>{capability.body}</p>
              <ul>
                {capability.tools.map((tool) => <li>{tool}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--deep about-boundaries">
    <div class="shell">
      <div class="about-boundaries-grid">
        <div data-reveal>
          <p class="eyebrow">Boundaries / 不声称的事</p>
          <h2>清楚的边界，<br /><em>也是作品的一部分。</em></h2>
          <p class="about-boundaries-lead">
            个人网站很容易把所有东西写成“致力于”“领先”“深度参与”。我尽量不这样做。
          </p>
        </div>
        <ul class="about-boundaries-list" data-reveal style="--reveal-delay:100ms">
          <li><span>01</span><p>不展示雇佣关系、客户名单或收入数据；没有公开证据的指标不写。</p></li>
          <li><span>02</span><p>不把 Fork、上游研究或二次开发包装成从零原创；来源在项目页逐项标注。</p></li>
          <li><span>03</span><p>不把书稿称为已出版作品，也不虚构 ISBN、出版社、销量或获奖记录。</p></li>
          <li><span>04</span><p>不声称服务过的用户规模、投资回报或生产级性能；测试数字只描述被测试的流程。</p></li>
          <li><span>05</span><p>旧站内容已不可恢复时，只保留 URL 与来源说明，不用推测补写历史。</p></li>
        </ul>
      </div>

      <div class="about-contact" data-reveal>
        <div>
          <p class="eyebrow">Contact / 交流</p>
          <h3>如果你也在构建<br /><em>需要长期维护的东西。</em></h3>
        </div>
        <div class="about-contact-links">
          <a href={site.github} target="_blank" rel="noreferrer">
            <span>GitHub</span>
            <small>github.com/zhubao315</small>
            <ArrowUpRight size={19} stroke-width={1.4} aria-hidden="true" />
          </a>
          <a href={site.x} target="_blank" rel="noreferrer">
            <span>X / Twitter</span>
            <small>x.com/zhubao315</small>
            <ArrowUpRight size={19} stroke-width={1.4} aria-hidden="true" />
          </a>
        </div>
        <p class="about-contact-note">
          合作、问题或只是想聊聊某个项目，公开渠道即可找到我。这里不提供虚构的邮箱与响应时间承诺。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
