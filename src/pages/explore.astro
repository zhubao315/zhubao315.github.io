---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { ArrowUpRight } from '@lucide/astro';
import { projects, lifeSites, categoryMeta, statusMeta } from '../data/projects';
import { brandFields } from '../data/brand';
import mbtiCover from '../assets/projects/mbti64.webp';
import perfectmeCover from '../assets/projects/perfectme.webp';

const mbti = projects.find((project) => project.id === 'mbti64')!;
const perfectme = projects.find((project) => project.id === 'perfectme')!;
const animeSkill = projects.find((project) => project.id === '2d-micro-anime-skill')!;
const memoir = projects.find((project) => project.id === 'memoir')!;
const uprompt = projects.find((project) => project.id === 'uprompt')!;
const creativeProjects = [animeSkill, memoir, uprompt];
---

<BaseLayout
  title="探索 | 朱宝 ZHUBAO"
  description="探索人格、数字生活、健康运动与 AI 创意：MBTI64、量化生活四个数据站点、原创 2D 微动漫《满分的我》。"
>
  <section class="page-hero explore-hero page-hero--brand">
    <div class="shell">
      <nav class="breadcrumb" aria-label="面包屑">
        <a href="/">首页</a><span class="sep">/</span><span>探索</span>
      </nav>

      <div class="page-masthead">
        <span><i aria-hidden="true"></i> FIELD NOTES / 03</span>
        <span>PERSONALITY · QUANTIFIED LIFE · CREATIVE</span>
        <span>SNAPSHOT 2026-11-11</span>
      </div>

      <div class="page-hero-title">
        <h1>Life,<br /><em>observed.</em></h1>
        <span class="page-hero-index">EXPLORE / 03</span>
      </div>
      <div class="explore-hero-body">
        <div>
          <p class="page-hero-intro">
            人格如何形成，身体如何变化，数据如何记住时间，故事如何被看见。探索页收录三个长期方向：人格探索、量化生活与 AI 创意。
          </p>
          <div class="page-hero-meta">
            <div class="hero-fact"><strong>64</strong><span>人格类型</span></div>
            <div class="hero-fact"><strong>4</strong><span>生活数据站点</span></div>
            <div class="hero-fact"><strong>11+ yrs</strong><span>最长记录跨度</span></div>
          </div>
        </div>
        <figure class="page-art explore-hero-art">
          <Image
            src={brandFields.measure}
            alt=""
            widths={[440, 620, 880]}
            sizes="(max-width: 1000px) 90vw, 292px"
            loading="eager"
            quality={78}
            format="webp"
          />
          <figcaption><span>FIELD STUDY / 03</span><span>LONGITUDINAL TRACE</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section explore-personality">
    <div class="shell">
      <div class="explore-feature">
        <div class="explore-feature-media" data-reveal>
          <Image
            src={mbtiCover}
            alt="MBTI64 人格测评站首页"
            widths={[600, 900, 1200]}
            sizes="(max-width: 900px) 100vw, 55vw"
            loading="eager"
            quality={84}
          />
          <span class="explore-media-label">LIVE PRODUCT / MBTI64</span>
        </div>
        <div class="explore-feature-copy" data-reveal>
          <p class="eyebrow">01 / Personality Exploration</p>
          <h2>认识自己，<br /><em>不需要一个标准答案。</em></h2>
          <p>
            MBTI64 把 16 型人格扩展成 64 型，用 120 道本土化情景题、六维计分与稀有度体系，提供一种更有层次的自我探索体验。答案只在浏览器本地计算。
          </p>
          <div class="explore-metrics">
            <div><strong>64</strong><span>种人格</span></div>
            <div><strong>120</strong><span>道情景题</span></div>
            <div><strong>7</strong><span>档稀有度</span></div>
          </div>
          <div class="explore-actions">
            <a class="button" href={mbti.demoUrl} target="_blank" rel="noreferrer">
              开始测评 <ArrowUpRight size={16} stroke-width={1.5} aria-hidden="true" />
            </a>
            <a class="text-link" href="/work/mbti64/">Case study</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--deep life-explore" id="quantified-life">
    <div class="shell">
      <header class="section-head section-head--dark">
        <div class="section-index"><span>02</span><i aria-hidden="true"></i></div>
        <div class="section-title">
          <p class="eyebrow">Quantified Life / 2015—2026</p>
          <h2>身体会忘记，<br />数据不会。</h2>
        </div>
        <div class="section-aside">
          <p class="section-note">
            四个独立站点共享一条数据管线。这里展示入口和快照，原始图表、异常与数据质量请进入各自站点查看。
          </p>
          <a class="text-link" href="/work/quantified-life/">系统说明 <ArrowUpRight size={15} stroke-width={1.4} aria-hidden="true" /></a>
        </div>
      </header>

      <div class="life-card-grid">
        {
          lifeSites.map((site, index) => (
            <a class="life-card" href={site.href} target="_blank" rel="noreferrer" data-accent={site.accent} data-reveal style={`--reveal-delay:${index * 70}ms`}>
              <div class="life-card-media">
                {site.image ? (
                  <Image
                    src={site.image}
                    alt={`${site.nameZh}数据面板截图`}
                    widths={[520, 800, 1100]}
                    sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 40vw"
                    loading="lazy"
                    quality={82}
                  />
                ) : (
                  <div class="life-card-terrain" aria-hidden="true">
                    <svg viewBox="0 0 420 260" preserveAspectRatio="none">
                      <path d="M-20 230 C 38 185, 80 212, 130 160 S 206 70, 250 130 S 330 200, 450 104" />
                      <path d="M-20 200 C 45 165, 92 180, 143 128 S 210 42, 263 104 S 348 170, 450 78" />
                      <path d="M-20 170 C 50 140, 100 145, 157 98 S 218 18, 276 78 S 360 138, 450 52" />
                      <path d="M-20 245 C 62 218, 108 240, 161 193 S 240 132, 290 162 S 375 218, 450 168" />
                    </svg>
                    <span>3D TERRAIN / BAKED FROM FIT</span>
                  </div>
                )}
                <span class="life-card-index">0{index + 1}</span>
              </div>
              <div class="life-card-body">
                <div class="life-card-name">
                  <strong>{site.name}</strong>
                  <span>{site.nameZh}</span>
                </div>
                <p>{site.description}</p>
                <div class="life-card-stat">
                  <strong>{site.stat}</strong>
                  <span>{site.unit}<br />{site.secondary}</span>
                </div>
                <span class="life-card-link">打开站点 <ArrowUpRight size={15} stroke-width={1.4} aria-hidden="true" /></span>
              </div>
            </a>
          ))
        }
      </div>

      <div class="data-principles" data-reveal>
        <p class="eyebrow">Data Principles / 数据原则</p>
        <div class="data-principles-grid">
          <div><span>01</span><strong>缺失 ≠ 零</strong><p>缺失值保持为空，不自动补零，不把“没有记录”伪装成“状态很好”。</p></div>
          <div><span>02</span><strong>同步可失败，历史不可倒退</strong><p>失败不推进水位，重拉不会用空值覆盖已存历史。</p></div>
          <div><span>03</span><strong>统计口径同源</strong><p>面板、CSV 与报告共享同一套计算定义，避免各说各话。</p></div>
        </div>
        <p class="data-snapshot">SNAPSHOT · 2026-11-11 · 数字以各站点实时页面为最终事实源</p>
      </div>
    </div>
  </section>

  <section class="section explore-film">
    <div class="shell">
      <div class="film-feature" data-reveal>
        <div class="film-media">
          <Image
            src={perfectmeCover}
            alt="原创 2D 微动漫《满分的我》画面"
            widths={[800, 1200, 1600]}
            sizes="(max-width: 900px) 100vw, 62vw"
            loading="lazy"
            quality={84}
          />
          <span class="film-badge">ORIGINAL 2D MICRO ANIMATION / 2'31"</span>
        </div>
        <div class="film-copy">
          <p class="eyebrow">03 / Creative Work</p>
          <h2>满分的我<br /><em>The Perfect Me</em></h2>
          <p class="film-quote">“如果所有人都喜欢那个完美的我，谁来喜欢真正的我？”</p>
          <p class="film-desc">
            一部以自我差异理论为内核的原创 2D 微动漫。从剧本、角色、分镜、AI 图像、配音、配乐到成片与宣传网站，完整走通一条创作链路。
          </p>
          <div class="explore-actions">
            <a class="button button--ghost" href={perfectme.demoUrl} target="_blank" rel="noreferrer">
              观看作品 <ArrowUpRight size={16} stroke-width={1.5} aria-hidden="true" />
            </a>
            <a class="text-link" href="/work/perfectme/">创作过程</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--paper-alt explore-lab">
    <div class="shell">
      <header class="section-head">
        <div class="section-index"><span>04</span><i aria-hidden="true"></i></div>
        <div class="section-title">
          <p class="eyebrow">Creative Laboratory / 实验</p>
          <h2>把叙事、工具与交互放在一起试。</h2>
        </div>
        <div class="section-aside">
          <p class="section-note">有些项目是产品，有些只是实验。它们共同保留了对新表达方式的探索。</p>
        </div>
      </header>

      <div class="lab-grid">
        {
          creativeProjects.map((project, index) => (
            <a class="lab-card" href={`/work/${project.slug}/`} data-reveal style={`--reveal-delay:${index * 60}ms`}>
              <div class="lab-top">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <span>{statusMeta[project.status].labelZh}</span>
              </div>
              <h3>{project.name}</h3>
              <p class="lab-zh">{project.nameZh}</p>
              <p class="lab-summary">{project.summary}</p>
              <div class="lab-bottom">
                <span>{categoryMeta[project.category].label}</span>
                <ArrowUpRight size={16} stroke-width={1.4} aria-hidden="true" />
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
