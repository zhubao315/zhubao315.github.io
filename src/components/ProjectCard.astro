---
import { ArrowUpRight } from '@lucide/astro';
import ProjectMedia from './ProjectMedia.astro';
import type { Project } from '../data/projects';
import { categoryMeta, statusMeta, sourceMeta } from '../data/projects';

interface Props {
  project: Project;
  index: string;
}

const { project, index } = Astro.props;
const category = categoryMeta[project.category];
const status = statusMeta[project.status];
const source = sourceMeta[project.sourceType];
const searchText = [
  project.name,
  project.nameZh,
  project.tagline,
  project.summary,
  ...project.tech,
  ...(project.metrics?.map((metric) => `${metric.value} ${metric.label}`) ?? []),
]
  .join(' ')
  .toLowerCase();
---

<article
  class:list={['project-card', `project-card--${category.accent}`, { 'project-card--featured': project.featured }]}
  data-project-card
  data-category={project.category}
  data-status={project.status}
  data-source={project.sourceType}
  data-featured={project.featured}
  data-search={searchText}
>
  <a class="project-card-media" href={`/work/${project.slug}/`} aria-label={`查看 ${project.name} 案例`}>
    <ProjectMedia project={project} />
  </a>
  <div class="project-card-body">
    <div class="project-card-topline">
      <span class="project-index">{index}</span>
      <span class:list={['status-label', `status-label--${project.status}`]}>
        <i aria-hidden="true"></i>{status.labelZh}
      </span>
      <span class="project-source">{source.labelZh}</span>
    </div>

    <div class="project-title-row">
      <div>
        <p class="project-category">{category.label} / {category.labelZh}</p>
        <h3><a href={`/work/${project.slug}/`}>{project.name}</a></h3>
        <p class="project-name-zh">{project.nameZh}</p>
      </div>
      {
        project.sourceType === 'original' ? (
          <span class="project-mark" aria-hidden="true">✦</span>
        ) : (
          <span class="project-mark project-mark--ring" aria-hidden="true"></span>
        )
      }
    </div>

    <p class="project-summary">{project.summary}</p>

    <ul class="project-tech" aria-label="技术栈">
      {project.tech.slice(0, 4).map((tech) => <li>{tech}</li>)}
    </ul>

    <div class="project-card-links">
      <a class="text-link text-link--small" href={`/work/${project.slug}/`}>
        查看案例 <ArrowUpRight size={15} stroke-width={1.5} aria-hidden="true" />
      </a>
      {
        project.demoUrl && (
          <a class="text-link text-link--small text-link--muted" href={project.demoUrl} target="_blank" rel="noreferrer">
            LIVE <ArrowUpRight size={15} stroke-width={1.5} aria-hidden="true" />
          </a>
        )
      }
      {
        !project.demoUrl && (
          <a class="text-link text-link--small text-link--muted" href={project.githubUrl} target="_blank" rel="noreferrer">
            GITHUB <ArrowUpRight size={15} stroke-width={1.5} aria-hidden="true" />
          </a>
        )
      }
    </div>
  </div>
</article>
