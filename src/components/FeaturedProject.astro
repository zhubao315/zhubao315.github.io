---
import { ArrowUpRight } from '@lucide/astro';
import type { Project } from '../data/projects';
import { categoryMeta, statusMeta } from '../data/projects';
import ProjectMedia from './ProjectMedia.astro';

interface Props {
  project: Project;
  index: string;
  reverse?: boolean;
  narrow?: boolean;
  wide?: boolean;
}

const { project, index, reverse = false, narrow = false, wide = false } = Astro.props;
const category = categoryMeta[project.category];
const status = statusMeta[project.status];
---

<article
  class:list={[
    'featured-piece',
    {
      'featured-piece--reverse': reverse,
      'featured-piece--narrow': narrow,
      'featured-piece--wide': wide,
    },
  ]}
  data-reveal
>
  <div class="featured-piece-media">
    <a href={`/work/${project.slug}/`} aria-label={`查看 ${project.name} 案例`}>
      <ProjectMedia project={project} />
    </a>
  </div>

  <div class="featured-piece-info">
    <div class="featured-meta">
      <span class="featured-number">FEATURED {index}</span>
      <span>{category.label} / {category.labelZh}</span>
      <span class:list={['status-label', `status-label--${project.status}`]}>
        <i aria-hidden="true"></i>{status.labelZh}
      </span>
    </div>

    <h3 class="featured-title"><a href={`/work/${project.slug}/`}>{project.name}</a></h3>
    <p class="featured-title-zh">{project.nameZh}</p>
    <p class="featured-summary">{project.summary}</p>

    <div class="featured-stats">
      {
        project.metrics?.slice(0, 3).map((metric) => (
          <div class="featured-stat">
            <strong>{metric.value}</strong>
            <span>{metric.label}</span>
          </div>
        ))
      }
    </div>

    <ul class="featured-tech" aria-label="技术栈">
      {project.tech.slice(0, 4).map((tech) => <li>{tech}</li>)}
    </ul>

    <div class="featured-links">
      <a class="button button--ghost" href={`/work/${project.slug}/`}>
        查看案例 <ArrowUpRight size={15} stroke-width={1.5} aria-hidden="true" />
      </a>
      {
        project.demoUrl && (
          <a class="text-link" href={project.demoUrl} target="_blank" rel="noreferrer">
            {project.demoLabel ?? '在线体验'} <ArrowUpRight size={14} stroke-width={1.4} aria-hidden="true" />
          </a>
        )
      }
      {
        !project.demoUrl && (
          <a class="text-link" href={project.githubUrl} target="_blank" rel="noreferrer">
            GitHub <ArrowUpRight size={14} stroke-width={1.4} aria-hidden="true" />
          </a>
        )
      }
    </div>
  </div>
</article>
