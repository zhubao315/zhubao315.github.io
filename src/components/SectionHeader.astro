---
import { ArrowUpRight } from '@lucide/astro';

interface Props {
  index: string;
  eyebrow: string;
  title: string;
  note?: string;
  link?: string;
  linkLabel?: string;
  dark?: boolean;
}

const { index, eyebrow, title, note, link, linkLabel = '查看全部', dark = false } = Astro.props;
---

<header class:list={['section-head', { 'section-head--dark': dark }]} data-reveal>
  <div class="section-index">
    <span>{index}</span>
    <i aria-hidden="true"></i>
  </div>
  <div class="section-title">
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
  </div>
  <div class="section-aside">
    {note && <p class="section-note">{note}</p>}
    {
      link && (
        <a class="text-link" href={link}>
          {linkLabel}
          <ArrowUpRight size={16} stroke-width={1.5} aria-hidden="true" />
        </a>
      )
    }
  </div>
</header>
