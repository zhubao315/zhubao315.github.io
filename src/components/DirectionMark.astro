---
interface Props {
  type: 'BUILD' | 'THINK' | 'MEASURE' | 'CREATE';
  class?: string;
}

const { type, class: className = '' } = Astro.props;
---

<svg
  class:list={['direction-icon', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  stroke-linejoin="miter"
  role="presentation"
  aria-hidden="true"
>
  {
    type === 'BUILD' && (
      <>
        <rect x="3" y="3" width="7" height="7" />
        <rect x="14" y="3" width="7" height="7" />
        <rect x="8.5" y="14" width="7" height="7" />
        <path d="M10 6.5h4M6.5 10v4h5.5M17.5 10v4h-5.5M12 14v-4" />
      </>
    )
  }
  {
    type === 'THINK' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <circle cx="12" cy="12" r="4" />
        <path d="M12 3v5M12 16v5M3 12h5M16 12h5" />
        <circle cx="12" cy="3" r="1" fill="currentColor" stroke="none" />
        <circle cx="21" cy="12" r="1" fill="currentColor" stroke="none" />
        <circle cx="12" cy="21" r="1" fill="currentColor" stroke="none" />
        <circle cx="3" cy="12" r="1" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    type === 'MEASURE' && (
      <>
        <path d="M3 3v18h18" />
        <path d="M6 17l4.5-5 3.5 2 5-8" />
        <path d="M6 20v-3M10.5 20v-3M14 20v-3M19 20v-3" />
        <circle cx="6" cy="17" r="1.2" fill="currentColor" stroke="none" />
        <circle cx="10.5" cy="12" r="1.2" fill="currentColor" stroke="none" />
        <circle cx="14" cy="14" r="1.2" fill="currentColor" stroke="none" />
        <circle cx="19" cy="6" r="1.2" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    type === 'CREATE' && (
      <>
        <rect x="3.5" y="3.5" width="10" height="10" />
        <circle cx="15.5" cy="15.5" r="5" />
        <path d="M8.5 8.5l7 7M15.5 3.5v4M20.5 15.5h-4" />
      </>
    )
  }
</svg>
