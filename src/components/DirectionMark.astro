---
interface Props {
  type: 'BUILD' | 'THINK' | 'MEASURE' | 'CREATE';
}

const { type } = Astro.props;
---

<svg viewBox="0 0 120 120" role="presentation" aria-hidden="true">
  {
    type === 'BUILD' && (
      <>
        <rect x="8" y="8" width="104" height="104" />
        <path d="M42 8v104M78 8v104M8 42h104M8 78h104" />
        <rect x="42" y="42" width="36" height="36" fill="currentColor" stroke="none" opacity=".9" />
        <circle cx="60" cy="60" r="3" fill="var(--navy)" stroke="none" />
      </>
    )
  }
  {
    type === 'THINK' && (
      <>
        <circle cx="60" cy="60" r="52" />
        <circle cx="60" cy="60" r="36" />
        <circle cx="60" cy="60" r="20" />
        <circle cx="60" cy="60" r="3.5" fill="currentColor" stroke="none" />
        <path d="M60 8v18M60 94v18M8 60h18M94 60h18" />
      </>
    )
  }
  {
    type === 'MEASURE' && (
      <>
        <path d="M12 104h96M12 104V8" />
        <rect x="25" y="72" width="11" height="32" fill="currentColor" stroke="none" opacity=".85" />
        <rect x="44" y="54" width="11" height="50" fill="currentColor" stroke="none" opacity=".65" />
        <rect x="63" y="38" width="11" height="66" fill="currentColor" stroke="none" opacity=".9" />
        <rect x="82" y="20" width="11" height="84" fill="currentColor" stroke="none" opacity=".55" />
        <path d="M25 66h11M44 48h11M63 32h11M82 14h11" />
      </>
    )
  }
  {
    type === 'CREATE' && (
      <>
        <path d="M60 7v106M7 60h106M22.5 22.5l75 75M97.5 22.5l-75 75" />
        <circle cx="60" cy="60" r="22" />
        <path d="M60 31l7 22 22 7-22 7-7 22-7-22-22-7 22-7 7-22Z" fill="currentColor" stroke="none" opacity=".9" />
      </>
    )
  }
</svg>
