---
import '@fontsource-variable/inter';
import '@fontsource-variable/manrope';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import '../styles/work.css';
import '../styles/editorial.css';
import '../styles/about.css';
import '../styles/responsive.css';
import '../styles/brand-v2.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  bodyClass?: string;
}

const {
  title = site.title,
  description = site.description,
  image = site.ogImage,
  type = 'website',
  noindex = false,
  bodyClass = '',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;
const isHome = Astro.url.pathname === '/';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: '朱宝',
  alternateName: 'ZHUBAO',
  url: site.url,
  image: new URL('/images/avatar.webp', site.url).href,
  jobTitle: 'AI Systems & Product Builder',
  description: site.description,
  knowsAbout: [
    'AI Engineering',
    'Agent Skills',
    'Knowledge Engineering',
    'Product Engineering',
    'Quantified Self',
  ],
  sameAs: [site.github, site.x],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `ZHUBAO · ${site.nameZh}个人数字作品集`,
  url: site.url,
  inLanguage: 'zh-CN',
  description,
  author: { '@type': 'Person', name: '朱宝', url: site.url },
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B1D33" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="author" content="朱宝 ZHUBAO" />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="ZHUBAO · Personal Brand & Digital Portfolio" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ZHUBAO · Build Systems. Engineer Knowledge. Measure Life. Create Things." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@zhubao315" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {!isHome && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: '首页', item: site.url + '/' },
            { '@type': 'ListItem', position: 2, name: title, item: canonical },
          ],
        })}
      />
    )}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      const revealItems = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        revealItems.forEach((item) => observer.observe(item));
      } else {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
